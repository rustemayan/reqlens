# Пример конфигурации ReqLens. Скопируйте в .env и вставьте свой ключ:
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Файл .env в git не попадает (см. .gitignore). Никогда не коммитьте ключи.

# ---------------------------------------------------------------------------
# Google Gemini — рекомендуемый вариант, бесплатный тариф Google AI Studio.
# Ключ: https://aistudio.google.com/ → Get API key → Create API key
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Если у основной модели кончилась дневная квота бесплатного тарифа,
# агент сам перейдёт на следующую модель из списка:
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-flash
# Глубина рассуждений Gemini 3.x (minimal / low / medium / high). Пусто — по умолчанию модели.
# GEMINI_THINKING_LEVEL=high

# ---------------------------------------------------------------------------
# Другие провайдеры (по выбору): раскомментируйте LLM_PROVIDER и ключ.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# Любой OpenAI-совместимый API: DeepSeek https://api.deepseek.com/v1, OpenRouter https://openrouter.ai/api/v1,
# Groq https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Локальная модель без ключа (Ollama):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# ---------------------------------------------------------------------------
# Тонкая настройка (необязательно)
# ---------------------------------------------------------------------------
# REQLENS_BATCH_SIZE=10        # требований в одном запросе: больше — меньше запросов к квоте
# LLM_MIN_INTERVAL=4           # пауза между запросами, секунд (для бесплатного тарифа)
# LLM_TIMEOUT=300              # таймаут одного запроса, секунд
# LLM_MAX_RETRIES=4            # повторов при 429/5xx
# LLM_MAX_OUTPUT_TOKENS=32768
# LLM_TEMPERATURE=0.1          # для Gemini 3.x Google рекомендует не задавать (оставить по умолчанию)
# REQLENS_CACHE=1              # кэш ответов модели в .reqlens_cache (0 — выключить)
# REQLENS_REVIEW=1             # проход ревьюера-скептика (0 — выключить, экономит 1 запрос)
